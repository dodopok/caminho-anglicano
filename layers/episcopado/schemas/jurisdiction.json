{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "acronym": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "former_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "communion",
        "province",
        "national_church",
        "diocese",
        "missionary_district",
        "network",
        "religious_order",
        "other"
      ]
    },
    "tradition": {
      "type": "string",
      "enum": [
        "anglican",
        "reformed_episcopal",
        "continuing_anglican",
        "charismatic_episcopal",
        "roman_catholic",
        "independent_catholic",
        "orthodox",
        "other"
      ]
    },
    "country": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        {
          "type": "null"
        }
      ]
    },
    "founded": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "place": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sources": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "discrepancies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sources": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        },
                        "page": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "source"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [
                  "field",
                  "value",
                  "sources"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "date",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "dissolved": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "date": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "place": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sources": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "page": {
                    "type": "string"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "discrepancies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sources": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        },
                        "page": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "source"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [
                  "field",
                  "value",
                  "sources"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "date",
            "sources"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "locator_slug": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "wikidata": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^Q\\d+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "website": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "string"
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "schism_from",
              "successor_of",
              "merged_with",
              "member_of",
              "part_of",
              "in_communion_with",
              "broke_communion_with",
              "recognized_by"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "led_by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "probable",
              "contested"
            ]
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            }
          },
          "discrepancies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sources": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "page": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "source"
                    ],
                    "additionalProperties": false
                  }
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "value",
                "sources"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "target",
          "status",
          "sources"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "type"
  ],
  "additionalProperties": false
}
